# Never commit secrets. Configuration comes from the environment.
.env
*.pem
*.key

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Editor
.vscode/
.idea/

# SDD scratch (ledger, briefs, review packages)
.superpowers/

# Runtime artifacts. This repo is public and publishes no schema content:
# a captured payload carries field keys and stored codes, and the usage log
# accumulates locally and would churn every commit.
smoke*.json
usage.log

# Evaluation outputs. The golden set itself IS committed (eval_data/golden.jsonl):
# it is the durable input every reported number rests on. These two are the
# outputs -- the run store and the rendered reports -- and they churn every run.
eval_data/evals.db
eval_data/reports/
