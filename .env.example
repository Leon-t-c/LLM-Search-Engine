# Copy to .env and fill in. .env is gitignored and must never be committed.
# No credential belongs in a .py file.

# Registry endpoint on the calling application (no trailing slash)
CERT_NLQ_REGISTRY_URL=
# Shared service token for that endpoint
CERT_NLQ_REGISTRY_TOKEN=

# LLM provider credentials
CERT_NLQ_OPENAI_API_KEY=
CERT_NLQ_MODEL=
# Cheaper model for stage-1 routing; blank means use CERT_NLQ_MODEL
CERT_NLQ_ROUTER_MODEL=
