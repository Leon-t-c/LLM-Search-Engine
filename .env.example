# Copy to .env and fill in. .env is gitignored and must never be committed.
# No credential belongs in a .py file.

# Registry endpoint on the calling application (no trailing slash)
CERT_NLQ_REGISTRY_URL=
# Shared service token for that endpoint
CERT_NLQ_REGISTRY_TOKEN=

# Inbound service token the calling application must present.
# Blank means the translate endpoint refuses every request.
CERT_NLQ_SERVICE_TOKEN=

# LLM provider credentials
CERT_NLQ_OPENAI_API_KEY=
CERT_NLQ_MODEL=
# Cheaper model for stage-1 routing; blank means use CERT_NLQ_MODEL
CERT_NLQ_ROUTER_MODEL=

# Which translator backend: openai | claude
CERT_NLQ_PROVIDER=openai
CERT_NLQ_ANTHROPIC_API_KEY=
CERT_NLQ_CLAUDE_MODEL=claude-opus-5
