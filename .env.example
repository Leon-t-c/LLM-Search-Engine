# Copy to .env and fill in. .env is gitignored and must never be committed.
# No credential belongs in a .py file.

# Registry endpoint on the calling application (no trailing slash)
CERT_NLQ_REGISTRY_URL=
# Shared service token for that endpoint
CERT_NLQ_REGISTRY_TOKEN=

# Inbound service token the calling application must present.
# Blank means the translate endpoint refuses every request.
CERT_NLQ_SERVICE_TOKEN=

# LLM provider credentials
CERT_NLQ_OPENAI_API_KEY=
CERT_NLQ_MODEL=
# Cheaper model for stage-1 routing; blank means use CERT_NLQ_MODEL
CERT_NLQ_ROUTER_MODEL=

# Which translator backend: openai | claude | ollama
CERT_NLQ_PROVIDER=openai
CERT_NLQ_ANTHROPIC_API_KEY=
CERT_NLQ_CLAUDE_MODEL=claude-opus-5
# Let the platform answer with a substitute model when the requested one
# declines. Off by default: a fallback changes which model answered, so
# turning it on is a deliberate availability decision, not an inherited one.
CERT_NLQ_CLAUDE_FALLBACKS=false

# Self-hosted, via Ollama on localhost. No key: it is a loopback service.
# See eval_data/README.md ("Running against a self-hosted Ollama model")
# for the setup this depends on -- install, pull, and running it beside the
# OpenAI config rather than over it.
CERT_NLQ_OLLAMA_URL=http://127.0.0.1:11434
# No default -- the tag depends on what was `ollama pull`ed on this box and
# drifts. Verify against `ollama list` rather than trusting a tag here.
CERT_NLQ_OLLAMA_MODEL=

# Where to append per-call usage records (token counts per stage).
# Blank means stderr only. Terminal scrollback is not a cost record.
CERT_NLQ_USAGE_LOG_PATH=
